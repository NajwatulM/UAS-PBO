<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="492.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.pesanController">
   <children>
      <AnchorPane prefHeight="64.0" prefWidth="440.0" style="-fx-background-color: black;">
         <children>
            <Button fx:id="closebtn" layoutX="396.0" layoutY="17.0" mnemonicParsing="false" onAction="#closebtnAction" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: none;" styleClass="close-button" stylesheets="@style.css">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="minimizebtn" layoutX="355.0" layoutY="15.0" mnemonicParsing="false" onAction="#minimizebtnAction" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: none;" styleClass="minimaze-button" stylesheets="@style.css">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button fx:id="back" layoutX="137.0" layoutY="18.0" mnemonicParsing="false" onAction="#b_back" prefHeight="27.0" prefWidth="82.0" text="KEMBALI">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
         </children>
      </AnchorPane>
      <TextField fx:id="filmid" disable="true" editable="false" layoutX="27.0" layoutY="117.0" prefHeight="25.0" prefWidth="390.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></TextField>
      <Label layoutX="27.0" layoutY="85.0" text="Film">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <TextField fx:id="nama" layoutX="25.0" layoutY="282.0" onKeyPressed="#onType" prefHeight="25.0" prefWidth="390.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></TextField>
      <Label layoutX="25.0" layoutY="250.0" text="Nama">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label layoutX="27.0" layoutY="165.0" text="Jumlah Kursi Dipesan">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <TextField fx:id="jumlah_seat" disable="true" editable="false" layoutX="27.0" layoutY="197.0" prefHeight="25.0" prefWidth="286.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></TextField>
      <Label layoutX="26.0" layoutY="338.0" text="Total bayar">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <TextField fx:id="harga_kursi" disable="true" editable="false" layoutX="27.0" layoutY="370.0" prefHeight="25.0" prefWidth="390.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></TextField>
      <Button layoutX="325.0" layoutY="197.0" mnemonicParsing="false" onAction="#pickseatAction" prefHeight="25.0" prefWidth="91.0" text="PILIH KURSI">
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Button layoutX="25.0" layoutY="423.0" mnemonicParsing="false" onAction="#cetakAction" prefHeight="27.0" prefWidth="390.0" text="CHECKOUT">
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Label layoutX="288.0" layoutY="91.0" text="Kursi Tersedia :">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label fx:id="data_kursi" layoutX="391.0" layoutY="91.0" text="100">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label fx:id="alert1" layoutX="219.0" layoutY="322.0" opacity="0.0" text="*Field nama tidak boleh kosong" textFill="RED">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="alert2" layoutX="269.0" layoutY="238.0" opacity="0.0" text="*Pesan kursi terlebih dahulu" textFill="RED" />
   </children>
</AnchorPane>
